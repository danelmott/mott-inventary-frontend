# Dirección del backend (Laravel)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Ruta sin sesión: adonde van el logout y el cierre de las páginas de los enlaces del correo
NEXT_PUBLIC_ROOT_PATH=/
# Adonde entra el usuario tras iniciar sesión o confirmar su correo
NEXT_PUBLIC_REDIRECT_PATH=/app/home
# "Continuar con Google" (login y registro): la ruta del backend que lleva a Google; al volver, el backend redirige al frontend
NEXT_PUBLIC_GOOGLE_AUTH_URL=http://localhost:8000/auth/google/redirect
